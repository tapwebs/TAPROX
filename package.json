{
  "name": "tapnettrack",
  "private": true,
  "version": "0.1.0",
  "description": "TAPNETTRACK: network visibility, packet intelligence and web security testing.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "shared/api-contracts",
    "apps/dashboard"
  ],
  "scripts": {
    "contracts:export": "uv run --directory backend --no-sync python -m scripts.export_contract",
    "contracts:generate": "npm run generate --workspace @tapnettrack/api-contracts",
    "contracts:check": "npm run check --workspace @tapnettrack/api-contracts",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @tapnettrack/dashboard",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
